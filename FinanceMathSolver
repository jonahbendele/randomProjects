#include<iostream>
#include<string>
#include<iomanip>

using namespace std;

int main()
{
	double Principal;
	double Rate;
	double Time;
	double PaymentPerPeriod;
	double PeriodsPerTime;
	double AcumulatedAmount;
	int select;
	int continueOption{ 0 };
	
	while (continueOption == 0)
	{
		cout << "Select an option:\n" << endl;
		cout << "1. solve for Principal\n" << endl;
		cout << "2. solve for PaymentPerPeriod\n" << endl;
		cout << "3.solve for AcumulatedAmount\n" << endl;
		cin >> select;
		cout << endl;
		cout << endl;

		switch (select)
		{
		case 1:
		{
			cout << "Enter the Acumulated Amount: ";
			cin >> AcumulatedAmount;
			cout << "Enter the Rate (as a decimal): ";
			cin >> Rate;
			cout << "Enter the Time: ";
			cin >> Time;
			cout << "Enter the number of periods per time unit: ";
			cin >> PeriodsPerTime;
			Principal = AcumulatedAmount / pow(1 + Rate / PeriodsPerTime, PeriodsPerTime * Time);
			cout << fixed << setprecision(2);
			cout << "The Principal amount is: $" << Principal << endl;
			cout << endl;
			cout << endl;
			break;
		}

		case 2:
		{
			cout << "Enter the Principal amount: ";
			cin >> Principal;
			cout << "Enter the Rate (as a decimal): ";
			cin >> Rate;
			cout << "Enter the Time: ";
			cin >> Time;
			cout << "Enter the number of periods per time unit: ";
			cin >> PeriodsPerTime;
			PaymentPerPeriod = (Principal * Rate) / PeriodsPerTime;
			cout << fixed << setprecision(2);
			cout << "The Payment per period is: $" << PaymentPerPeriod << endl;
			cout << endl;
			cout << endl;
			break;
		}

		case 3:
		{
			cout << "Enter the Principal amount: ";
			cin >> Principal;
			cout << "Enter the Rate (as a decimal): ";
			cin >> Rate;
			cout << "Enter the Time: ";
			cin >> Time;
			cout << "Enter the number of periods per time unit: ";
			cin >> PeriodsPerTime;
			AcumulatedAmount = Principal * pow(1 + Rate / PeriodsPerTime, PeriodsPerTime * Time);
			cout << fixed << setprecision(2);
			cout << "The accumulated amount is: $" << AcumulatedAmount << endl;
			cout << endl;
			cout << endl;
			break;
		}
		default:
		{
			cout << "Invalid option." << endl;
			break;
		}
		
		}
		cout << "Do you want to continue? (0 for yes, 1 for no): ";
		cin >> continueOption;
		cout << endl;
		cout << endl;
		cout << endl;
		cout << endl;
		cout << endl;
	}
	return 0;
}
